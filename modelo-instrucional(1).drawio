    <mxCell id="n9" value="H" style="ellipse;html=1;fontSize=12;fontStyle=1;fillColor=#FFFFFF;strokeColor=#1B2631;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="1187" y="287" width="26" height="26" as="geometry"/></mxCell>
    <mxCell id="n10" value="&lt;i&gt;Registra acertos, erros, tentativas e tempo; consolida o desempenho por requisito (R1 a R5) para o relatório do professor.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#909497;fontColor=#5D6D7E;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="810" y="665" width="400" height="120" as="geometry"/></mxCell>
    <mxCell id="n11" value="&lt;b&gt;Abertura&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;entry / exibir boas-vindas e apresentar os objetivos&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;entry / ativar conhecimentos prévios (pergunta disparadora)&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D6D7E&quot;&gt;Gagné: ganhar atenção · informar objetivos · recordar pré-requisitos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#B7950B;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="440" height="110" as="geometry"/></mxCell>
    <mxCell id="n12" value="&lt;b&gt;Pausado&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;entry / salvar o progresso&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D6D7E&quot;&gt;retomar devolve ao ponto em que parou (H)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECF7;strokeColor=#7D3C98;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="300" height="90" as="geometry"/></mxCell>
    <mxCell id="n13" value="&lt;b&gt;Fase 1 — Reconhecer (R1)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Identificar hardware e software no cotidiano&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D6D7E&quot;&gt;BNCC: EF02CO04 · EF15CO07&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#21618C;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="130" y="375" width="470" height="100" as="geometry"/></mxCell>
    <mxCell id="n14" value="&lt;b&gt;Fase 2 — Classificar (R2)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Organizar elementos em categorias funcionais&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D6D7E&quot;&gt;BNCC: EF02CO05 · EF15CO06&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#21618C;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="130" y="535" width="470" height="100" as="geometry"/></mxCell>
    <mxCell id="n15" value="&lt;b&gt;Fase 3 — Relacionar (R3)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Associar componentes às suas funções&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D6D7E&quot;&gt;BNCC: EF15CO06 · EF15CO07 · EF15CO08&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#21618C;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="130" y="695" width="470" height="100" as="geometry"/></mxCell>
    <mxCell id="n16" value="&lt;b&gt;Fase 4 — Analisar (R4)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Resolver situações-problema do dia a dia&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D6D7E&quot;&gt;BNCC: EF02CO05 · EF15CO08&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#21618C;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="130" y="855" width="470" height="100" as="geometry"/></mxCell>
    <mxCell id="n17" value="&lt;b&gt;Aguardando interação&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;do / acompanhar tempo e engajamento&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#5D6D7E;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="810" y="385" width="400" height="70" as="geometry"/></mxCell>
    <mxCell id="n18" value="&lt;b&gt;Feedback imediato&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;entry / exibir correção comentada&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5D6D7E&quot;&gt;reforça o acerto ou explica o erro&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#5D6D7E;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="810" y="520" width="400" height="80" as="geometry"/></mxCell>
    <mxCell id="n19" value="&lt;b&gt;Autoavaliação&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;entry / abrir formulário de&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;autoavaliação do estudante&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7950B;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="140" y="1140" width="260" height="100" as="geometry"/></mxCell>
    <mxCell id="n20" value="&lt;b&gt;Uso seguro e responsável&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;entry / exibir mensagem sobre&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;segurança e ética digital&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B7950B;fontColor=#1B2631;" vertex="1" parent="1"><mxGeometry x="450" y="1140" width="260" height="100" as="geometry"/></mxCell>
